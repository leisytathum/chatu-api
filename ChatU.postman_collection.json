{
  "info": {
    "name": "ChatU API | 10 casos obligatorios",
    "description": "Ejecutar desde el caso 01. Cada corrida crea sus propios usuarios y sala. El caso 07 prepara 25 mensajes automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "betoId",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Salud",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', Date.now().toString(36) + Math.random().toString(36).slice(2,6));",
              "for (const key of ['userId', 'betoId', 'roomId', 'messageId']) pm.collectionVariables.unset(key);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test(\"API activa\", () => { pm.expect(pm.response.json()).to.deep.equal({ok:true,data:'ChatU API activa'}); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Crear usuarios",
      "item": [
        {
          "name": "02A Crear Ana",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ana_{{runId}}\",\n  \"email\": \"ana_{{runId}}@ceutec.edu\",\n  \"status\": \"online\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02B Crear Beto",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"beto_{{runId}}\",\n  \"email\": \"beto_{{runId}}@ceutec.edu\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('betoId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Correo duplicado",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/users",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"dup_{{runId}}\",\n  \"email\": \"ana_{{runId}}@ceutec.edu\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
              "pm.test(\"DUPLICATE\", () => { pm.expect(pm.response.json().error.code).to.equal('DUPLICATE'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Crear sala",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/rooms",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sala Vanguardia {{runId}}\",\n  \"ownerId\": \"{{userId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test(\"Ana es dueña y miembro\", () => { const d = pm.response.json().data; const id = pm.collectionVariables.get('userId'); pm.expect(d.owner).to.equal(id); pm.expect(d.members).to.include(id); });",
              "pm.collectionVariables.set('roomId', pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Enviar sin pertenecer",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/rooms/{{roomId}}/messages",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": \"{{betoId}}\",\n  \"content\": \"Hola, soy Beto\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
              "pm.test(\"NOT_MEMBER\", () => { pm.expect(pm.response.json().error.code).to.equal('NOT_MEMBER'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Unir a Beto",
      "item": [
        {
          "name": "06A Unirse",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/rooms/{{roomId}}/join",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{betoId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"Beto es miembro\", () => { pm.expect(pm.response.json().data.members).to.include(pm.collectionVariables.get('betoId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06B Repetir ingreso",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/rooms/{{roomId}}/join",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{betoId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test(\"ALREADY_MEMBER\", () => { pm.expect(pm.response.json().error.code).to.equal('ALREADY_MEMBER'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "07 Enviar 25 y consultar página 2",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/rooms/{{roomId}}/messages?page=2&limit=20"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const url = pm.variables.replaceIn('{{baseUrl}}/rooms/{{roomId}}/messages');",
              "for (let i = 1; i <= 25; i += 1) {",
              "  const response = await pm.sendRequest({",
              "    url,",
              "    method: 'POST',",
              "    header: {'Content-Type':'application/json'},",
              "    body: {mode:'raw',raw:JSON.stringify({",
              "      senderId: pm.collectionVariables.get('betoId'),",
              "      content: 'Mensaje ' + i",
              "    })}",
              "  });",
              "  if (response.code !== 201) throw new Error('Falló el mensaje ' + i + ': HTTP ' + response.code);",
              "  if (i === 1) pm.collectionVariables.set('messageId', response.json().data._id);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "",
              "pm.test('Página 2 contiene cinco mensajes y el total es 25', () => {",
              "  const result = pm.response.json();",
              "  pm.expect(result.meta).to.deep.equal({page:2,limit:20,total:25});",
              "  pm.expect(result.data).to.have.lengthOf(5);",
              "  pm.expect(result.data.map(message => message.content)).to.deep.equal([",
              "    'Mensaje 5', 'Mensaje 4', 'Mensaje 3', 'Mensaje 2', 'Mensaje 1'",
              "  ]);",
              "  pm.expect(result.data[0].sender.username).to.equal('beto_' + pm.collectionVariables.get('runId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Rechazar mensaje vacío",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/rooms/{{roomId}}/messages",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": \"{{betoId}}\",\n  \"content\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test(\"VALIDATION\", () => { pm.expect(pm.response.json().error.code).to.equal('VALIDATION'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Editar mensaje",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/messages/{{messageId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Mensaje editado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test(\"Edición guardada\", () => { const d = pm.response.json().data; pm.expect(d.edited).to.equal(true); pm.expect(d.content).to.equal('Mensaje editado'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Rechazar ID inválido",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/rooms/123"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test(\"INVALID_ID\", () => { pm.expect(pm.response.json().error.code).to.equal('INVALID_ID'); });"
            ]
          }
        }
      ]
    }
  ]
}
